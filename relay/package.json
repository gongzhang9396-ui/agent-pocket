    "react-dom": "^19.1.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "overrides": {
    "glob": "10.5.0",
    "uuid": "11.1.1"
  }
