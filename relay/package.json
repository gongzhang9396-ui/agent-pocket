  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "build": "tsc -p tsconfig.json && tsc -p admin/tsconfig.json --noEmit && vite build --config admin/vite.config.ts",
