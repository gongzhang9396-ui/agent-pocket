AGENT_POCKET_RELAY_BIND=127.0.0.1
AGENT_POCKET_RELAY_PORT=8790
AGENT_POCKET_RELAY_DB=/var/lib/agent-pocket-relay/relay.db
AGENT_POCKET_RELAY_ADMIN_DIR=/opt/agent-pocket-relay/current/admin/dist
