AGENT_POCKET_RELAY_URL=https://relay.example.com
AGENT_POCKET_RELAY_BIND=127.0.0.1
AGENT_POCKET_RELAY_PORT=8790
AGENT_POCKET_RELAY_DB=/var/lib/agent-pocket-relay/relay.db
AGENT_POCKET_RELAY_ADMIN_DIR=/opt/agent-pocket-relay/current/admin/dist
AGENT_POCKET_RELAY_UPDATES_DIR=/var/lib/agent-pocket-relay/updates
# Base64-encoded DER SubjectPublicKeyInfo for the offline Ed25519 update signing key.
# AGENT_POCKET_UPDATE_PUBLIC_KEY_SPKI=MCowBQYDK2VwAyEA...
# Keep the Firebase service-account JSON outside the release directory.
# AGENT_POCKET_FIREBASE_SERVICE_ACCOUNT=/etc/agent-pocket-relay/firebase-service-account.json
